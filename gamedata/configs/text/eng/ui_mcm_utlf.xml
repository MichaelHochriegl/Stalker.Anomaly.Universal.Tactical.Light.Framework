        <text>Beam range</text>
    </string>
    <string id="ui_mcm_utlf_modular_flashlights_range_desc">
        <text>Maximum beam distance. Higher values reach farther.</text>
    </string>
    <string id="ui_mcm_utlf_modular_flashlights_cone_deg">
