local strfind = string.find

local magnifier_switch_wrapped = false

local function defaults()
    return utlf_core.DEFAULTS
end

local function state()
    return utlf_core.get_state()
end

local function clear_light_refs(reason, had_light)
    if had_light then
        printf("[utlf] disabled%s", reason and (": " .. reason) or "")
    end

    local s = state()
    s.weapon = nil
    s.weapon_id = nil
    s.section = nil
    s.hud = nil
    s.profile = nil
    s.attachment = nil
    s.attachment_name = nil
    s.attachment_is_modular = false
    s.light = nil
end

function detach_light(reason, stale_only, keep_attachment)
    local s = state()
    local had_light = s.light ~= nil

    if s.light then
        pcall(function()
            s.light.enabled = false
        end)
    end

    if s.attachment then
        pcall(function()
            s.attachment:detach_light()
        end)
    end

    if keep_attachment or stale_only then
        clear_light_refs(reason, had_light)
        return
    end

    local weapon = utlf_core.state_weapon()
    if not weapon then
        clear_light_refs(reason, had_light)
        return
    end

    if s.attachment then
        pcall(function()
            weapon:remove_attachment(s.attachment)
        end)
        pcall(function()
            weapon:remove_attachment(s.attachment_name or defaults().BUILT_IN_ATTACHMENT_NAME)
        end)
    end

    clear_light_refs(reason, had_light)
end

function detach_current_light(reason, stale_only)
    local s = state()
    detach_light(reason, stale_only, s.attachment_is_modular == true)
end

local function create_built_in_attachment(weapon, profile, hud)
    local d = defaults()
    local model = utlf_core.attachment_model(weapon, profile)
    local attachment_name = profile.attachment_name or d.BUILT_IN_ATTACHMENT_NAME
    local attachment
    local ok, err = pcall(function()
        attachment = weapon:add_attachment(attachment_name, model)
    end)

    if not ok or not attachment then
        error("add_attachment failed: " .. tostring(err))
    end

    attachment:set_type(profile.attachment_type or d.ATTACHMENT_TYPE_HUD)

    pcall(function()
        attachment:set_scale(profile.attachment_scale or d.ATTACHMENT_SCALE)
    end)

    local fire_bone = profile.fire_bone or SYS_GetParam(0, hud, "fire_bone", d.FIRE_BONE)
    local fire_point = utlf_core.vector_from(profile.fire_point, d.FIRE_POINT)

    attachment:set_parent_bone(fire_bone)
    attachment:set_position(fire_point)
    printf("[utlf] created built-in HUD attachment for %s on '%s' using carrier '%s'", weapon:section(), fire_bone, model)

    return attachment, attachment_name
end

local function create_light(attachment, profile)
    local light = attachment_script_light()
    light.type = profile.light_type
    light.range = profile.range
    light.hud_mode = profile.hud_mode
    light.shadow = profile.shadow
    light.volumetric = profile.volumetric
    light.volumetric_distance = profile.volumetric_distance
    light.volumetric_intensity = profile.volumetric_intensity
    light.volumetric_quality = profile.volumetric_quality
    light.texture = profile.texture
    light.color = utlf_core.color_from(profile.color)
    light:set_position(0, 0, 0)
    light:set_direction(0, 0, 0)
    light:set_cone(math.rad(profile.cone_deg))
    light.enabled = true

    attachment:attach_light(light)
    attachment:set_light_bone(profile.light_bone)

    return light
end

function ensure_modular_attachment(weapon, profile)
    return utlf_modular.ensure_attachment(weapon, profile)
end

function detach_modular_item(weapon, return_item)
    return utlf_modular.detach_item(weapon, return_item)
end

function attach_light(weapon, profile, reason)
    detach_current_light(reason)

    local s = state()
    local ok, err = pcall(function()
        local hud = utlf_core.weapon_hud_section(weapon)
        local attachment
        local attachment_name
        local attachment_is_modular = utlf_core.is_modular_profile(profile)
        local light_profile = profile

        if attachment_is_modular then
            local saved = utlf_core.saved_modular_light(weapon)
            attachment = utlf_modular.ensure_attachment(weapon, profile)
            attachment_name = defaults().MODULAR_ATTACHMENT_NAME
            if not attachment then
                error("no modular tactical light item attached")
            end
            light_profile = utlf_core.light_profile_for_item(saved and saved.section)
        else
            attachment, attachment_name = create_built_in_attachment(weapon, profile, hud)
        end

        local light = create_light(attachment, light_profile)

        s.weapon = weapon
        s.weapon_id = weapon:id()
        s.section = weapon:section()
        s.hud = hud
        s.profile = light_profile
        s.attachment = attachment
        s.attachment_name = attachment_name
        s.attachment_is_modular = attachment_is_modular
        s.light = light
    end)

    if ok and s.light then
        utlf_core.clear_replacement()
        printf("[utlf] enabled attached light for %s (%s)", weapon:section(), tostring(s.weapon_id))
    else
        s.desired_on = false
        detach_current_light("enable failed")
        printf("[utlf] failed to enable attached light for %s: %s", weapon:section(), tostring(err))
    end
end

function rebuild_active_light(reason)
    local s = state()
    if not s.desired_on or not s.light then
        return
    end

    local weapon, profile = utlf_core.active_supported_weapon()
    if not weapon or not profile or weapon:id() ~= s.weapon_id then
        return
    end

    attach_light(weapon, profile, reason or "profile changed")
end

local function reattach_after_replacement(reason)
    local s = state()
    if not s.desired_on then
        utlf_core.clear_replacement()
        return
    end

    local weapon, profile = utlf_core.active_supported_weapon()
    if not weapon or not profile then
        if utlf_core.replacement_pending() then
            CreateTimeEvent("utlf", "reattach_after_replacement", 0.1, function()
                reattach_after_replacement(reason)
                return true
            end)
        else
            s.desired_on = false
            utlf_core.clear_replacement()
        end
        return
    end

    if s.replacement_target_section and weapon:section() ~= s.replacement_target_section then
        s.desired_on = false
        utlf_core.clear_replacement()
        return
    end

    attach_light(weapon, profile, reason or "weapon replacement")
end

local function schedule_reattach_after_replacement(profile, target_section)
    local s = state()
    local delay = profile.reattach_delay_ms
    s.replacement_until = time_global() + delay + profile.replacement_window_ms
    s.replacement_target_section = target_section

    CreateTimeEvent("utlf", "reattach_after_replacement", delay / 1000, function()
        reattach_after_replacement("transferring to replacement weapon")
        return true
    end)
end

local function wrap_magnifier_switch()
    if magnifier_switch_wrapped then
        return
    end

    if not (magnifier_switch and magnifier_switch.switch_magnifier) then
        return
    end

    local original_switch_magnifier = magnifier_switch.switch_magnifier
    magnifier_switch.switch_magnifier = function(wpn, sec, new_sec)
        local weapon = wpn or db.actor:active_item()
        local section = sec or (weapon and weapon:section())
        local profile = utlf_core.profile_for_section(section)
        local target_section = new_sec
        if not target_section and section and magnifier_switch.get_new_section then
            target_section = magnifier_switch.get_new_section(section)
        end

        local s = state()
        if s.desired_on and s.light and weapon and profile and target_section and target_section ~= section then
            printf("[utlf] disabling light before 3DSS magnifier replacement")
            detach_current_light("before magnifier replacement", true)
            schedule_reattach_after_replacement(profile, target_section)
        end

        return original_switch_magnifier(wpn, sec, new_sec)
    end

    magnifier_switch_wrapped = true
    printf("[utlf] wrapped 3DSS magnifier switch")
end

local function actor_on_hud_animation_play(anim_table, weapon)
    if not anim_table or not anim_table.anm_name or not strfind(anim_table.anm_name, "^anm_show") then
        return
    end

    local active = db.actor and db.actor:active_item()
    if not active or not utlf_core.safe_is_weapon(active) then
        return
    end

    local s = state()
    local profile = utlf_core.profile_for_section(active:section())
    if s.light and s.weapon_id and active:id() ~= s.weapon_id and not profile then
        s.desired_on = false
        utlf_core.clear_replacement()
        detach_current_light("active weapon changed")
        return
    end

    if not profile then
        return
    end

    if s.light and s.weapon_id and active:id() ~= s.weapon_id then
        if utlf_core.replacement_pending() and (not s.replacement_target_section or active:section() == s.replacement_target_section) then
            detach_current_light("weapon object replaced", true)
            schedule_reattach_after_replacement(profile, active:section())
        else
            s.desired_on = false
            utlf_core.clear_replacement()
            detach_current_light("active weapon changed")
        end
    end

    if utlf_core.is_modular_profile(profile) then
        utlf_modular.ensure_attachment(active, profile)
    end

    if s.desired_on and not s.light and utlf_core.replacement_pending() then
        attach_light(active, profile, "HUD animation replacement attach")
    end
end

local function save_state()
    local s = state()
    s.desired_on = false
    utlf_core.clear_replacement()
    detach_current_light("saving")
end

function on_game_start()
    wrap_magnifier_switch()
    utlf_input.on_game_start()

    RegisterScriptCallback("actor_on_hud_animation_play", actor_on_hud_animation_play)
    RegisterScriptCallback("save_state", save_state)
end
