local function default_toggle_key()
    return utlf and utlf.get_default_toggle_key and utlf.get_default_toggle_key() or DIK_keys.DIK_L
end

local function default_toggle_modifier()
    return utlf and utlf.get_default_toggle_modifier and utlf.get_default_toggle_modifier() or 3
end

local function framework_page()
    return {
        id = "framework",
        sh = true,
        gr = {
            { id = "controls_title", type = "desc", clr = { 200, 200, 255, 200 }, text = "ui_mcm_utlf_controls_title" },
            { id = "controls_description", type = "desc", text = "ui_mcm_utlf_controls_description" },
            { id = "toggle_key", type = "key_bind", val = 2, def = default_toggle_key(), hint = "utlf_toggle_key" },
            {
                id = "toggle_modifier",
                type = ui_mcm.kb_mod_radio,
                val = 2,
                def = default_toggle_modifier(),
                hint = "utlf_toggle_modifier",
                content = {
                    { 0, "mcm_kb_mod_none" },
                    { 1, "mcm_kb_mod_shift" },
                    { 2, "mcm_kb_mod_ctrl" },
                    { 3, "mcm_kb_mod_alt" },
                },
            },
        },
    }
end

local function ensure_collection(options)
    options = options or {}

    for _, option in ipairs(options) do
        if option.id == "utlf" then
            option.gr = option.gr or {}
            return option
        end
    end

    local collection = { id = "utlf", gr = {} }
    table.insert(options, collection)
    return collection
end

function on_mcm_load(options)
    if not options then
        return framework_page(), "utlf"
    end

    local collection = ensure_collection(options)

    for index, page in ipairs(collection.gr) do
        if page.id == "framework" then
            table.remove(collection.gr, index)
            break
        end
    end

    table.insert(collection.gr, 1, framework_page())
end
