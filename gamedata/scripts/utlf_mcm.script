local function default_toggle_key()
    return utlf and utlf.get_default_toggle_key and utlf.get_default_toggle_key() or DIK_keys.DIK_L
end

local function default_toggle_modifier()
    return utlf and utlf.get_default_toggle_modifier and utlf.get_default_toggle_modifier() or 3
end

local function defaults()
    return utlf_core.DEFAULTS
end

local function modular_flashlight_entries()
    if utlf_items and utlf_items.modular_flashlight_mcm_entries then
        return utlf_items.modular_flashlight_mcm_entries()
    end

    return {}
end

local function framework_page()
    return {
        id = "framework",
        sh = true,
        gr = {
            { id = "controls_title", type = "desc", clr = { 200, 200, 255, 200 }, text = "ui_mcm_utlf_controls_title" },
            { id = "controls_description", type = "desc", text = "ui_mcm_utlf_controls_description" },
            { id = "toggle_key", type = "key_bind", val = 2, def = default_toggle_key(), hint = "utlf_toggle_key" },
            {
                id = "toggle_modifier",
                type = ui_mcm.kb_mod_radio,
                val = 2,
                def = default_toggle_modifier(),
                hint = "utlf_toggle_modifier",
                content = {
                    { 0, "mcm_kb_mod_none" },
                    { 1, "mcm_kb_mod_shift" },
                    { 2, "mcm_kb_mod_ctrl" },
                    { 3, "mcm_kb_mod_alt" },
                },
            },
            { id = "battery_title", type = "desc", clr = { 200, 200, 255, 200 }, text = "ui_mcm_utlf_battery_title" },
            { id = "battery_description", type = "desc", text = "ui_mcm_utlf_battery_description" },
            {
                id = "battery_enabled",
                type = "check",
                val = 1,
                def = defaults().BATTERY_ENABLED,
                hint = "utlf_battery_enabled",
            },
            {
                id = "show_no_battery_symbol",
                type = "check",
                val = 1,
                def = defaults().SHOW_NO_BATTERY_SYMBOL,
                hint = "utlf_show_no_battery_symbol",
            },
            {
                id = "default_battery_type",
                type = "input",
                val = 0,
                def = defaults().BATTERY_TYPE,
                hint = "utlf_default_battery_type",
            },
            {
                id = "default_battery_consumption",
                type = "input",
                val = 2,
                min = 0,
                max = 1,
                def = defaults().BATTERY_CONSUMPTION,
                hint = "utlf_default_battery_consumption",
            },
        },
    }
end

local function modular_flashlights_page()
    local controls = {
        { id = "title", type = "desc", clr = { 200, 200, 255, 200 }, text = "ui_mcm_utlf_modular_flashlights_title" },
        { id = "description", type = "desc", text = "ui_mcm_utlf_modular_flashlights_description" },
    }

    for _, item in ipairs(modular_flashlight_entries()) do
        controls[#controls + 1] = { id = item.mcm_key .. "_title", type = "desc", clr = { 200, 200, 255, 200 }, text = item.heading }
        controls[#controls + 1] = {
            id = item.range.id,
            type = "track",
            val = 2,
            min = item.range.min,
            max = item.range.max,
            step = 1,
            def = item.range.def,
            hint = "utlf_modular_flashlights_range",
        }
        controls[#controls + 1] = {
            id = item.cone_deg.id,
            type = "track",
            val = 2,
            min = item.cone_deg.min,
            max = item.cone_deg.max,
            step = 1,
            def = item.cone_deg.def,
            hint = "utlf_modular_flashlights_cone_deg",
        }
        controls[#controls + 1] = {
            id = item.battery_type.id,
            type = "input",
            val = 0,
            def = item.battery_type.def,
            hint = "utlf_modular_flashlights_battery_type",
        }
        controls[#controls + 1] = {
            id = item.battery_consumption.id,
            type = "input",
            val = 2,
            min = item.battery_consumption.min,
            max = item.battery_consumption.max,
            def = item.battery_consumption.def,
            hint = "utlf_modular_flashlights_battery_consumption",
        }
    end

    return {
        id = "modular_flashlights",
        sh = true,
        gr = controls,
    }
end

local function utlf_collection()
    return {
        id = "utlf",
        gr = {
            framework_page(),
            modular_flashlights_page(),
        },
    }
end

local function ensure_collection(options)
    options = options or {}

    for _, option in ipairs(options) do
        if option.id == "utlf" then
            option.gr = option.gr or {}
            return option
        end
    end

    local collection = { id = "utlf", gr = {} }
    table.insert(options, collection)
    return collection
end

function on_mcm_load(options)
    if not options then
        return utlf_collection()
    end

    local collection = ensure_collection(options)

    for index = #collection.gr, 1, -1 do
        local page = collection.gr[index]
        if page and (page.id == "framework" or page.id == "modular_flashlights") then
            table.remove(collection.gr, index)
        end
    end

    table.insert(collection.gr, 1, modular_flashlights_page())
    table.insert(collection.gr, 1, framework_page())
end
