local modular_attachments = {}

local function defaults()
    return utlf_core.DEFAULTS
end

local function state()
    return utlf_core.get_state()
end

function ensure_attachment(weapon, profile)
    if not weapon or not profile or not utlf_core.is_modular_profile(profile) then
        return nil
    end

    local d = defaults()
    local saved = utlf_core.saved_modular_light(weapon)
    if not saved or not saved.section then
        pcall(function()
            weapon:remove_attachment(d.MODULAR_ATTACHMENT_NAME)
        end)
        modular_attachments[weapon:id()] = nil
        return nil
    end

    local existing = weapon:get_attachment(d.MODULAR_ATTACHMENT_NAME)
    if existing then
        modular_attachments[weapon:id()] = existing
        return existing
    end

    local model = utlf_core.modular_attachment_model(saved.section, profile)
    local attachment
    local ok, err = pcall(function()
        attachment = weapon:add_attachment(d.MODULAR_ATTACHMENT_NAME, model)
    end)

    if not ok or not attachment then
        printf("[utlf] failed to create modular attachment for %s: %s", weapon:section(), tostring(err))
        return nil
    end

    local transform = profile.transform
    attachment:set_type(profile.attachment_type or d.ATTACHMENT_TYPE_HUD)
    attachment:set_parent_bone(transform.bone)
    attachment:set_position(transform.x, transform.y, transform.z)
    attachment:set_rotation(transform.rx, transform.ry, transform.rz)
    attachment:set_scale(transform.scale, transform.scale, transform.scale)

    modular_attachments[weapon:id()] = attachment
    printf("[utlf] created modular attachment for %s using '%s'", weapon:section(), model)
    return attachment
end

function detach_item(weapon, return_item)
    if not weapon then
        return false
    end

    local saved = utlf_core.saved_modular_light(weapon)
    if not saved or not saved.section then
        return false
    end

    if return_item then
        alife_create_item(saved.section, db.actor)
    end

    local s = state()
    if s.weapon_id == weapon:id() then
        s.desired_on = false
        utlf_core.clear_replacement()
        utlf_lights.detach_light("modular light detached", false, false)
    else
        pcall(function()
            weapon:remove_attachment(defaults().MODULAR_ATTACHMENT_NAME)
        end)
    end

    modular_attachments[weapon:id()] = nil
    utlf_core.clear_modular_light(weapon)
    return true
end
