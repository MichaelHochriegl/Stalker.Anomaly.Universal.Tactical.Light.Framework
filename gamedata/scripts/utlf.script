function register_light(section, profile)
    return utlf_core.register_light(section, profile)
end

function register_pack(pack_name, profiles)
    return utlf_core.register_pack(pack_name, profiles)
end

function register_attachment_group(group_name, sections)
    return utlf_core.register_attachment_group(group_name, sections)
end

local function register_builtin_light_pack(pack_name, profile, config)
    register_pack(pack_name, { utlf_core.configured_profile(profile, config) })
end

function setup_builtin_light_pack(pack_name, profile, config)
    register_builtin_light_pack(pack_name, profile, config)

    RegisterScriptCallback("on_option_change", function()
        register_builtin_light_pack(pack_name, profile, config)

        if not config or config.rebuild_active_light ~= false then
            local weapon = db.actor and db.actor:active_item()
            if weapon and utlf_core.safe_is_weapon(weapon) and utlf_core.profile_supports_section(profile, weapon:section()) then
                rebuild_active_light((config and config.rebuild_reason) or (tostring(pack_name) .. " settings changed"))
            end
        end
    end)
end

function clamp_number(value, fallback, min_value, max_value)
    return utlf_core.clamp_number(value, fallback, min_value, max_value)
end

function get_mcm_number(path, fallback, min_value, max_value)
    return utlf_core.get_mcm_number(path, fallback, min_value, max_value)
end

function get_default_toggle_key()
    return utlf_core.DEFAULTS.TOGGLE_KEY
end

function get_default_toggle_modifier()
    return utlf_core.DEFAULTS.TOGGLE_MODIFIER
end

function rebuild_active_light(reason)
    return utlf_lights.rebuild_active_light(reason)
end

function on_option_change()
    utlf_core.refresh_settings()
end

function on_game_start()
    utlf_core.refresh_settings()
    utlf_lights.on_game_start()
    utlf_inventory.on_game_start()

    RegisterScriptCallback("on_option_change", on_option_change)
    printf("[utlf] loaded; registered sections: %s", utlf_core.loaded_sections_count())
end
