local strfind = string.find
local strgsub = string.gsub

local ATTACHMENT_NAME = "utlf_tactical_light_attachment"
local ATTACHMENT_TYPE_HUD = 0
local DEFAULT_TOGGLE_KEY = DIK_keys.DIK_L
local DEFAULT_TOGGLE_MODIFIER = 3 -- MCM modifier: 0 = none, 1 = shift, 2 = ctrl, 3 = alt
local DEFAULT_FIRE_BONE = "wpn_body"
local DEFAULT_LIGHT_BONE = "wpn_body"
local DEFAULT_FIRE_POINT = "0,0,0.035"
local DEFAULT_ATTACHMENT_SCALE = 0.001
local DEFAULT_RANGE = 26
local DEFAULT_CONE_DEG = 24
local DEFAULT_TEXTURE = "internal\\internal_tactical_torch"
local DEFAULT_REATTACH_DELAY_MS = 250
local DEFAULT_PRE_REPLACEMENT_DELAY_MS = 400
local DEFAULT_REPLACEMENT_WINDOW_MS = 1000
local snd_tactical_light = sound_object("interface\\inv_torch")

local registered = {}
local magnifier_switch_wrapped = false
local original_torch_toggle = nil
local wrapped_torch_toggle = nil
local suppress_torch_until = nil
local suppress_torch_release_key = nil

local state = {
    desired_on = false,
    weapon = nil,
    weapon_id = nil,
    section = nil,
    hud = nil,
    profile = nil,
    attachment = nil,
    attachment_name = nil,
    light = nil,
    reattach_after = nil,
    replacement_until = nil,
    replacement_target_section = nil,
}

local settings = {
    toggle_key = DEFAULT_TOGGLE_KEY,
    toggle_modifier = DEFAULT_TOGGLE_MODIFIER,
}

local function copy_profile(profile)
    local copy = {}
    for key, value in pairs(profile or {}) do
        copy[key] = value
    end
    return copy
end

local function normalize_sections(sections)
    if type(sections) == "string" then
        return { sections }
    end
    return sections or {}
end

function register_light(section, profile)
    if not section or type(profile) ~= "table" then
        return
    end

    local copy = copy_profile(profile)
    copy.section = section
    registered[section] = copy
end

function register_pack(pack_name, profiles)
    for _, profile in ipairs(profiles or {}) do
        for _, section in ipairs(normalize_sections(profile.sections)) do
            register_light(section, profile)
            printf("[utlf] registered %s from %s", section, tostring(pack_name or "unknown pack"))
        end
    end
end

local function profile_for_section(section)
    if not section then
        return nil
    end

    local profile = registered[section]
    if profile then
        return profile
    end

    local parent = ini_sys:r_string_ex(section, "parent_section")
    if parent then
        return registered[parent]
    end
end

local function active_supported_weapon()
    local item = db.actor and db.actor:active_item()
    if item and IsWeapon(item) then
        local profile = profile_for_section(item:section())
        if profile then
            return item, profile
        end
    end
end

local function weapon_hud_section(weapon)
    return SYS_GetParam(0, weapon:section(), "hud", weapon:section())
end

local function attachment_model(weapon, profile)
    local model = profile.attachment_model or profile.model or SYS_GetParam(0, weapon:section(), "visual", nil)
    if not model or model == "" then
        model = profile.default_model or SYS_GetParam(0, weapon:section(), "visual", weapon:section())
    end
    model = strgsub(model, "%.ogf$", "")
    return model
end

local function vector_from(value, fallback)
    if type(value) == "userdata" then
        return value
    end
    return utils_data.string_to_vector(value or fallback)
end

local function color_from(value)
    local color = fcolor()
    if type(value) == "table" then
        return color:set(value[1] or 1.0, value[2] or 0.94, value[3] or 0.78, value[4] or 0.55)
    end
    return color:set(1.0, 0.94, 0.78, 0.55)
end

local function dik_pressed(left, right)
    return (key_state(left) or 0) ~= 0 or (key_state(right) or 0) ~= 0
end

local function configured_modifier_pressed(modifier)
    modifier = tonumber(modifier) or 0

    local shift = dik_pressed(DIK_keys.DIK_LSHIFT, DIK_keys.DIK_RSHIFT)
    local ctrl = dik_pressed(DIK_keys.DIK_LCONTROL, DIK_keys.DIK_RCONTROL)
    local alt = dik_pressed(DIK_keys.DIK_LMENU, DIK_keys.DIK_RMENU)

    if modifier == 1 then
        return shift
    elseif modifier == 2 then
        return ctrl
    elseif modifier == 3 then
        return alt
    end

    return not (shift or ctrl or alt)
end

local function suppress_engine_torch(key)
    suppress_torch_release_key = key
    suppress_torch_until = time_global() + 3000
end

local function engine_torch_suppressed()
    return suppress_torch_until and time_global() <= suppress_torch_until
end

local function refresh_settings()
    if not ui_mcm then
        return
    end

    settings.toggle_key = tonumber(ui_mcm.get("utlf/toggle_key")) or DEFAULT_TOGGLE_KEY
    settings.toggle_modifier = tonumber(ui_mcm.get("utlf/toggle_modifier")) or DEFAULT_TOGGLE_MODIFIER
end

local function wrap_engine_torch_toggle()
    if not actor_effects or not actor_effects.Hit_TorchToggle then
        return
    end

    if wrapped_torch_toggle and actor_effects.Hit_TorchToggle == wrapped_torch_toggle then
        return
    end

    original_torch_toggle = actor_effects.Hit_TorchToggle
    wrapped_torch_toggle = function(...)
        if engine_torch_suppressed() then
            return
        end

        return original_torch_toggle(...)
    end
    actor_effects.Hit_TorchToggle = wrapped_torch_toggle

    printf("[utlf] wrapped engine torch toggle")
end

function get_default_toggle_key()
    return DEFAULT_TOGGLE_KEY
end

function get_default_toggle_modifier()
    return DEFAULT_TOGGLE_MODIFIER
end

local function state_weapon()
    if not state.weapon_id then
        return nil
    end

    local obj = get_object_by_id(state.weapon_id)
    if obj and IsWeapon(obj) then
        return obj
    end
end

local function clear_replacement()
    state.reattach_after = nil
    state.replacement_until = nil
    state.replacement_target_section = nil
end

local function replacement_pending()
    return state.replacement_until and time_global() <= state.replacement_until
end

local function clear_light_refs(reason, had_light)
    if had_light then
        printf("[utlf] disabled%s", reason and (": " .. reason) or "")
    end

    state.weapon = nil
    state.weapon_id = nil
    state.section = nil
    state.hud = nil
    state.profile = nil
    state.attachment = nil
    state.attachment_name = nil
    state.light = nil
end

local function detach_light(reason, stale_only)
    local had_light = state.light ~= nil

    if state.light then
        pcall(function()
            state.light.enabled = false
        end)
    end

    if state.attachment then
        pcall(function()
            state.attachment:detach_light()
        end)
    end

    -- Weapon replacement systems can destroy the old object before callbacks run.
    -- In that case, only drop Lua references; do not touch stale game object userdata.
    if stale_only then
        clear_light_refs(reason, had_light)
        return
    end

    local weapon = state_weapon()
    if not weapon then
        clear_light_refs(reason, had_light)
        return
    end

    if state.attachment then
        pcall(function()
            weapon:remove_attachment(state.attachment)
        end)
        pcall(function()
            weapon:remove_attachment(state.attachment_name or ATTACHMENT_NAME)
        end)
    end

    clear_light_refs(reason, had_light)
end

local function create_attachment(weapon, profile, hud)
    local model = attachment_model(weapon, profile)
    local attachment_name = profile.attachment_name or ATTACHMENT_NAME
    local attachment
    local ok, err = pcall(function()
        attachment = weapon:add_attachment(attachment_name, model)
    end)

    if not ok or not attachment then
        error("add_attachment failed: " .. tostring(err))
    end

    attachment:set_type(profile.attachment_type or ATTACHMENT_TYPE_HUD)

    pcall(function()
        attachment:set_scale(profile.attachment_scale or DEFAULT_ATTACHMENT_SCALE)
    end)

    local fire_bone = profile.fire_bone or SYS_GetParam(0, hud, "fire_bone", DEFAULT_FIRE_BONE)
    local fire_point = vector_from(profile.fire_point, DEFAULT_FIRE_POINT)

    attachment:set_parent_bone(fire_bone)
    attachment:set_position(fire_point)
    printf("[utlf] created HUD attachment for %s on '%s' using carrier '%s'", weapon:section(), fire_bone, model)

    return attachment
end

local function create_light(attachment, profile)
    local light = attachment_script_light()
    light.type = profile.light_type or 2 -- 1 = point, 2 = spot
    light.range = profile.range or DEFAULT_RANGE
    light.hud_mode = profile.hud_mode == true
    light.shadow = profile.shadow ~= false
    light.volumetric = profile.volumetric == true
    light.volumetric_distance = profile.volumetric_distance or 0.25
    light.volumetric_intensity = profile.volumetric_intensity or 0.02
    light.volumetric_quality = profile.volumetric_quality or 0.25
    light.texture = profile.texture or DEFAULT_TEXTURE
    light.color = color_from(profile.color)
    light:set_position(0, 0, 0)
    light:set_direction(0, 0, 0)
    light:set_cone(math.rad(profile.cone_deg or DEFAULT_CONE_DEG))
    light.enabled = true

    attachment:attach_light(light)
    attachment:set_light_bone(profile.light_bone or DEFAULT_LIGHT_BONE)

    return light
end

local function attach_light(weapon, profile, reason)
    detach_light(reason)

    local ok, err = pcall(function()
        local hud = weapon_hud_section(weapon)
        local attachment = create_attachment(weapon, profile, hud)
        local light = create_light(attachment, profile)

        state.weapon = weapon
        state.weapon_id = weapon:id()
        state.section = weapon:section()
        state.hud = hud
        state.profile = profile
        state.attachment = attachment
        state.attachment_name = profile.attachment_name or ATTACHMENT_NAME
        state.light = light
    end)

    if ok and state.light then
        clear_replacement()
        printf("[utlf] enabled attached light for %s (%s)", weapon:section(), tostring(state.weapon_id))
    else
        state.desired_on = false
        detach_light("enable failed")
        printf("[utlf] failed to enable attached light for %s: %s", weapon:section(), tostring(err))
    end
end

local function play_toggle_sound(enabled)
    snd_tactical_light.frequency = enabled and 1.15 or 0.85
    snd_tactical_light:play(db.actor, 0, sound_object.s2d)
end

local function wrap_magnifier_switch()
    if magnifier_switch_wrapped then
        return
    end

    if not (magnifier_switch and magnifier_switch.switch_magnifier) then
        return
    end

    local original_switch_magnifier = magnifier_switch.switch_magnifier
    magnifier_switch.switch_magnifier = function(wpn, sec, new_sec)
        local weapon = wpn or db.actor:active_item()
        local section = sec or (weapon and weapon:section())
        local profile = profile_for_section(section)
        local target_section = new_sec
        if not target_section and section and magnifier_switch.get_new_section then
            target_section = magnifier_switch.get_new_section(section)
        end

        if state.desired_on and state.light and weapon and profile and target_section and target_section ~= section then
            printf("[utlf] disabling light before 3DSS magnifier replacement")
            local delay = profile.pre_replacement_delay_ms or DEFAULT_PRE_REPLACEMENT_DELAY_MS
            state.reattach_after = time_global() + delay
            state.replacement_until = state.reattach_after + (profile.replacement_window_ms or DEFAULT_REPLACEMENT_WINDOW_MS)
            state.replacement_target_section = target_section
            detach_light("before magnifier replacement")
        end

        return original_switch_magnifier(wpn, sec, new_sec)
    end

    magnifier_switch_wrapped = true
    printf("[utlf] wrapped 3DSS magnifier switch")
end

local function toggle_light()
    local weapon, profile = active_supported_weapon()
    if not weapon then
        return true
    end

    if state.desired_on then
        state.desired_on = false
        clear_replacement()
        detach_light("manual toggle")
        play_toggle_sound(false)
    else
        state.desired_on = true
        clear_replacement()
        attach_light(weapon, profile)
        if state.light then
            play_toggle_sound(true)
        end
    end

    return true
end

local function on_before_key_press(key, bind, dis, flags)
    if key ~= settings.toggle_key or not configured_modifier_pressed(settings.toggle_modifier) then
        return
    end

    suppress_engine_torch(key)

    if flags then
        flags.ret_value = false
    end

    local weapon = active_supported_weapon()
    if not weapon then
        return
    end

    if device():is_paused() or not actor_menu.is_hud_free() then
        return
    end

    if weapon:get_state() ~= 0 then
        return
    end

    toggle_light()
end

local function on_before_key_release(key, bind, dis, flags)
    if key ~= suppress_torch_release_key then
        return
    end

    if flags then
        flags.ret_value = false
    end

    suppress_torch_release_key = nil
    suppress_torch_until = time_global() + 250
end

local function actor_on_update()
    wrap_engine_torch_toggle()
    wrap_magnifier_switch()

    if not state.desired_on then
        return
    end

    local weapon, profile = active_supported_weapon()
    if not weapon then
        if replacement_pending() then
            return
        end

        if state.light then
            detach_light("supported weapon no longer active")
        end

        state.desired_on = false
        clear_replacement()
        return
    end

    if state.reattach_after and time_global() < state.reattach_after then
        return
    end

    if state.light and weapon:id() ~= state.weapon_id then
        if replacement_pending() and (not state.replacement_target_section or weapon:section() == state.replacement_target_section) then
            printf("[utlf] active supported weapon replaced during known replacement; delaying light transfer %s -> %s", tostring(state.weapon_id), tostring(weapon:id()))
            state.reattach_after = time_global() + (profile.reattach_delay_ms or DEFAULT_REATTACH_DELAY_MS)
            detach_light("weapon object replaced", true)
            return
        end

        state.desired_on = false
        clear_replacement()
        detach_light("active weapon changed")
        return
    end

    if not state.light then
        if state.replacement_target_section and weapon:section() ~= state.replacement_target_section then
            state.desired_on = false
            clear_replacement()
            return
        end

        if not replacement_pending() then
            state.desired_on = false
            clear_replacement()
            return
        end

        printf("[utlf] attaching light to active supported weapon %s", weapon:section())
        attach_light(weapon, profile, "transferring to active supported weapon")
        return
    end
end

local function save_state()
    state.desired_on = false
    clear_replacement()
    detach_light("saving")
end

function on_option_change()
    refresh_settings()
end

function on_game_start()
    refresh_settings()
    wrap_engine_torch_toggle()
    RegisterScriptCallback("on_before_key_press", on_before_key_press)
    RegisterScriptCallback("on_before_key_release", on_before_key_release)
    RegisterScriptCallback("actor_on_update", actor_on_update)
    RegisterScriptCallback("save_state", save_state)
    RegisterScriptCallback("on_option_change", on_option_change)
    wrap_magnifier_switch()
    printf("[utlf] loaded; registered sections: %s", tostring(table.size and table.size(registered) or "unknown"))
end
